// Regras do Firestore da versão 2 (projeto "sextante-v2"; documentação técnica, passo 1.14).
// Publicar no console do Firebase: Firestore Database > Regras > colar este arquivo > Publicar.
//
// Provisórias até os papéis por espaço (passo 2.1), como na versão em uso:
// - qualquer pessoa consulta;
// - só quem entrou com e-mail e senha cria e altera;
// - ninguém apaga: a exclusão é lógica (passo 1.15);
// - o histórico de alterações só recebe registros novos: ninguém altera nem apaga (passo 1.16);
// - os retratos só são criados: depois, ninguém altera nem apaga (passo 1.18);
// - comentários (passo 2.9): quem entrou escreve em nome próprio (e-mail do login, em minúsculas, como o sistema guarda); só o autor edita ou apaga
//   (esconde), guardando as versões anteriores; ninguém apaga do banco; apagado, não muda mais;
// - fora destes caminhos, nada.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    match /espacos/{espacoId} {
      allow read: if true;
      allow create, update: if logado();
      match /acoes/{numero} {
        allow read: if true;
        allow create, update: if logado();
      }
      // responsáveis de cada espaço (passo 1.14b)
      match /responsaveis/{responsavelId} {
        allow read: if true;
        allow create, update: if logado();
      }
      // histórico de alterações das ações (passo 1.16): só de acréscimo (sem update nem delete)
      match /historico/{registroId} {
        allow read: if true;
        allow create: if logado();
      }
      // comentários das ações (passo 2.9): nunca apagados do banco (documentação técnica, seção 4.2.3)
      match /comentarios/{comentarioId} {
        allow read: if true;
        allow create: if logado()
          && request.resource.data.autor == request.auth.token.email.lower()
          && request.resource.data.id == comentarioId
          && request.resource.data.versoes.size() == 0
          && !('apagadoEm' in request.resource.data);
        allow update: if logado()
          && resource.data.autor == request.auth.token.email.lower()
          && !('apagadoEm' in resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.acao == resource.data.acao
          && request.resource.data.autor == resource.data.autor
          && request.resource.data.criadoEm == resource.data.criadoEm
          && request.resource.data.versoes.size() >= resource.data.versoes.size()
          && request.resource.data.versoes[0:resource.data.versoes.size()] == resource.data.versoes
          && (!('apagadoPor' in request.resource.data) || request.resource.data.apagadoPor == request.auth.token.email.lower());
      }
      // retratos (passo 1.18): cabeçalho e ações, só leitura depois de criados
      match /retratos/{retratoId} {
        allow read: if true;
        allow create: if logado();
        match /acoes/{numero} {
          allow read: if true;
          allow create: if logado();
        }
      }
    }
    match /sistema/calendario {
      allow read: if true;
      allow create, update: if logado();
    }
  }
}
