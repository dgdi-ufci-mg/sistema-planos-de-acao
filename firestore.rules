// Regras do Firestore da versão 2 (projeto "sextante-v2"; documentação técnica, seção 3.6).
// Publicar no console do Firebase: Firestore Database > Regras > colar este arquivo > Publicar.
//
// Papéis por espaço (passo 2.1; seção 16.3), as mesmas regras de js/papeis.js:
// - visibilidade (passo 2.2): o cabeçalho do espaço (nome, configuração, papéis) é legível por todos, para a
//   barra lateral e "Espaços abertos à consulta" funcionarem (decisão do responsável, 24/10/2026: a proteção
//   completa fica para o sistema definitivo); o conteúdo (ações, responsáveis, histórico, comentários e
//   retratos) só é lido conforme a visibilidade: pública, todos; institucional, quem entrou; restrita, quem tem
//   papel; sem `visibilidade` (espaços antigos), pública;
// - o espaço guarda em `acessos` o papel de cada e-mail: administrador, usuario ou leitor;
// - espaço sem `acessos` (criado antes dos papéis, como a PI²): regra provisória de antes, quem entrou altera
//   tudo, até alguém assumir a administração (gravar `acessos`);
// - quem cria um espaço tem de ser administrador dele;
// - administrador: tudo no espaço;
// - usuario: atualiza ações (no espaço fechado, só aquelas em que é responsável; nas outras, só a volta à
//   situação inicial que o sistema faz ao desfazer uma conclusão), sem excluir nem restaurar; cria
//   responsáveis sem login; acrescenta etiquetas ao catálogo; salva retratos; comenta;
// - leitor: só comenta;
// - comentários (passo 2.9): quem tem papel escreve em nome próprio (e-mail do login, em minúsculas); só o
//   autor edita ou apaga (esconde), guardando as versões anteriores; o administrador do espaço também apaga;
//   ninguém apaga do banco; apagado, não muda mais;
// - espaço encerrado (passo 2.3): só leitura para todos; o administrador só reabre (apaga `encerradoEm`);
// - Administrador do Sistema (passo 2.3): e-mails em sistema/administradores, documento editado só no console
//   (em minúsculas); muda o calendário geral e nomeia um administrador num espaço órfão, com registro em
//   `nomeacoes`; fora isso, não tem passe livre nos espaços;
// - ninguém apaga documentos: a exclusão é lógica (passo 1.15); histórico e retratos só recebem registros novos;
// - fora destes caminhos, nada.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    function eu() {
      return request.auth.token.email.lower();
    }
    // espaço sem administração: criado antes dos papéis e ainda não assumido
    function livre(d) {
      return !('acessos' in d);
    }
    function papelNo(d) {
      return d.get('acessos', {}).get(eu(), {}).get('papel', '');
    }
    // Administrador do Sistema (passo 2.3)
    function adminSistema() {
      let caminho = /databases/$(database)/documents/sistema/administradores;
      return logado() && exists(caminho) && eu() in get(caminho).data.get('emails', []);
    }

    match /espacos/{espacoId} {
      function esp() {
        return get(/databases/$(database)/documents/espacos/$(espacoId)).data;
      }
      function administra() {
        return logado() && (livre(esp()) || papelNo(esp()) == 'administrador');
      }
      function atua() {
        return logado() && (livre(esp()) || papelNo(esp()) in ['administrador', 'usuario']);
      }
      // quem consulta o conteúdo do espaço (passo 2.2)
      function podeVer() {
        let d = esp();
        let v = d.get('visibilidade', 'publica');
        return v == 'publica' || (logado() && (v == 'institucional' || livre(d) || papelNo(d) != ''));
      }
      // espaço não encerrado (passo 2.3): só nele se grava conteúdo
      function aberto() {
        return esp().get('encerradoEm', null) == null;
      }
      function membro() {
        return logado() && (livre(esp()) || papelNo(esp()) in ['administrador', 'usuario', 'leitor']);
      }
      // o usuário muda no espaço só os tons das pessoas e acrescenta etiquetas ao catálogo (sem mudar as que existem)
      function soTonsEEtiquetas() {
        let mudou = request.resource.data.diff(resource.data).affectedKeys();
        let antes = resource.data.get('etiquetas', []);
        return mudou.hasOnly(['tons', 'etiquetas', 'alteradoEm', 'alteradoPor'])
          && (!mudou.hasAny(['etiquetas'])
            || (request.resource.data.etiquetas.size() >= antes.size() && request.resource.data.etiquetas[0:antes.size()] == antes));
      }

      allow read: if true;
      allow create: if logado() && request.resource.data.get('acessos', {}).get(eu(), {}).get('papel', '') == 'administrador';
      // reabrir: o administrador só apaga o encerramento
      function soReabrir() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['encerradoEm', 'encerradoPor', 'alteradoEm', 'alteradoPor'])
          && request.resource.data.encerradoEm == null;
      }
      // espaço órfão: o Administrador do Sistema acrescenta uma nomeação em nome próprio e o administrador nomeado, e nada mais
      function soNomeacao() {
        let antes = resource.data.get('nomeacoes', []);
        let depois = request.resource.data.nomeacoes;
        let nova = depois[antes.size()];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acessos', 'nomeacoes', 'alteradoEm', 'alteradoPor'])
          && depois.size() == antes.size() + 1 && depois[0:antes.size()] == antes && nova.por == eu()
          && request.resource.data.acessos.diff(resource.data.get('acessos', {})).affectedKeys().hasOnly([nova.email])
          && request.resource.data.acessos[nova.email].papel == 'administrador';
      }
      allow update: if logado() && (
        (resource.data.get('encerradoEm', null) == null && (
          livre(resource.data)
          || papelNo(resource.data) == 'administrador'
          || (papelNo(resource.data) == 'usuario' && soTonsEEtiquetas())))
        || (resource.data.get('encerradoEm', null) != null && (livre(resource.data) || papelNo(resource.data) == 'administrador') && soReabrir())
        || (adminSistema() && soNomeacao()));

      match /acoes/{numero} {
        function minha() {
          return esp().acessos[eu()].get('responsavel', '') in resource.data.get('responsaveis', []);
        }
        // ao desfazer uma conclusão, as seguintes voltam à situação inicial (passo 2.7), mesmo sem serem do usuário
        function soVoltaAInicial() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['situacaoPersonalizada', 'alteradaEm', 'alteradaPor'])
            && request.resource.data.situacaoPersonalizada == null;
        }
        allow read: if podeVer();
        allow create: if aberto() && administra();
        allow update: if aberto() && (administra()
          || (logado() && papelNo(esp()) == 'usuario'
            && request.resource.data.get('excluidaEm', null) == resource.data.get('excluidaEm', null)
            && (!esp().get('fechado', false) || minha() || soVoltaAInicial())));
      }
      // responsáveis de cada espaço (passo 1.14b); o usuário cadastra só responsáveis sem login
      match /responsaveis/{responsavelId} {
        allow read: if podeVer();
        allow create: if aberto() && (administra()
          || (logado() && papelNo(esp()) == 'usuario' && request.resource.data.get('usuario', null) == null));
        allow update: if aberto() && administra();
      }
      // histórico de alterações das ações (passo 1.16): só de acréscimo (sem update nem delete)
      match /historico/{registroId} {
        allow read: if podeVer();
        allow create: if aberto() && atua();
      }
      // comentários das ações (passo 2.9): nunca apagados do banco (documentação técnica, seção 4.2.3)
      match /comentarios/{comentarioId} {
        allow read: if podeVer();
        allow create: if aberto() && membro()
          && request.resource.data.autor == eu()
          && request.resource.data.id == comentarioId
          && request.resource.data.versoes.size() == 0
          && !('apagadoEm' in request.resource.data);
        allow update: if aberto() && ((membro()
          && resource.data.autor == eu()
          && !('apagadoEm' in resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.acao == resource.data.acao
          && request.resource.data.autor == resource.data.autor
          && request.resource.data.criadoEm == resource.data.criadoEm
          && request.resource.data.versoes.size() >= resource.data.versoes.size()
          && request.resource.data.versoes[0:resource.data.versoes.size()] == resource.data.versoes
          && (!('apagadoPor' in request.resource.data) || request.resource.data.apagadoPor == eu()))
          // o administrador do espaço esconde comentários alheios, sem mudar o texto (passo 2.1)
          || (logado() && papelNo(esp()) == 'administrador'
            && !('apagadoEm' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['apagadoEm', 'apagadoPor', 'apagadoComo'])
            && request.resource.data.apagadoComo == 'administrador'
            && request.resource.data.apagadoPor == eu()));
      }
      // retratos (passo 1.18): cabeçalho e ações, só leitura depois de criados
      match /retratos/{retratoId} {
        allow read: if podeVer();
        allow create: if aberto() && atua();
        match /acoes/{numero} {
          allow read: if podeVer();
          allow create: if aberto() && atua();
        }
      }
    }
    // calendário geral: só o Administrador do Sistema altera (passo 2.3)
    match /sistema/calendario {
      allow read: if true;
      allow create, update: if adminSistema();
    }
    // Administradores do Sistema (passo 2.3): lidos por quem entrou; gravados só no console do Firebase
    match /sistema/administradores {
      allow read: if logado();
      allow write: if false;
    }
  }
}
