// Regras do Firestore da versão 2 (projeto "sextante-v2"; especificação, passo 1.14).
// Publicar no console do Firebase: Firestore Database > Regras > colar este arquivo > Publicar.
//
// Provisórias até os papéis por espaço (passo 2.1), como na versão em uso:
// - qualquer pessoa consulta;
// - só quem entrou com e-mail e senha cria e altera;
// - ninguém apaga: a exclusão é lógica (passo 1.15);
// - o histórico de alterações só recebe registros novos: ninguém altera nem apaga (passo 1.16);
// - fora destes caminhos, nada.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }
    match /espacos/{espacoId} {
      allow read: if true;
      allow create, update: if logado();
      match /acoes/{numero} {
        allow read: if true;
        allow create, update: if logado();
      }
      // responsáveis de cada espaço (passo 1.14b)
      match /responsaveis/{responsavelId} {
        allow read: if true;
        allow create, update: if logado();
      }
      // histórico de alterações das ações (passo 1.16): só de acréscimo (sem update nem delete)
      match /historico/{registroId} {
        allow read: if true;
        allow create: if logado();
      }
    }
    match /sistema/calendario {
      allow read: if true;
      allow create, update: if logado();
    }
  }
}
